def _looks_like_jwt(token: str) -> bool:
    return token.count(".") == 2 and len(token) > 60


def fetch_cognito_token(domain: str, client_id: str, client_secret: str, scope: str = ""):
    """OAuth2 client-credentials request to a Cognito token endpoint. Returns the token string or None.
    The secret and the token are never printed."""
    domain = domain.strip()
    local = domain.replace("https://", "").replace("http://", "").startswith(("localhost", "127.0.0.1"))
    if not domain.startswith(("http://", "https://")):
        domain = ("http://" if local else "https://") + domain
    if "/oauth2/token" not in domain:
        domain = domain.rstrip("/") + "/oauth2/token"

    form = {"grant_type": "client_credentials", "client_id": client_id, "client_secret": client_secret}
    if scope:
        form["scope"] = scope
    req = urllib.request.Request(
        domain, data=urllib.parse.urlencode(form).encode("utf-8"), method="POST",
        headers={"Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json"})

    log.info(f"Requesting token from {domain.split('?')[0]} ...")
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode("utf-8", errors="replace"))
    except urllib.error.HTTPError as e:
        try:
            body = e.read().decode("utf-8", errors="replace")
        except Exception:
            body = ""
        log.error(red(f"Token request failed: HTTP {e.code} {e.reason}"))
        if body:
            print(f"  Response body: {body[:500]}")
        if e.code in (400, 401):
            print(yellow("  Hint: check the client ID and secret, that the app client allows the client-credentials flow,\n"
                         "  and whether a scope is required (invalid_client / invalid_scope in the body will say which)."))
        return None
    except (TimeoutError, socket.timeout):
        log.error(red("Token request timed out."))
        return None
    except urllib.error.URLError as e:
        log.error(red(f"Network error reaching the token endpoint: {e.reason}"))
        print(yellow("  Hint: check the Cognito domain (for example https://<prefix>.auth.<region>.amazoncognito.com)."))
        return None
    except (json.JSONDecodeError, OSError) as e:
        log.error(red(f"Unexpected token response: {e}"))
        return None

    token = data.get("access_token")
    if not token:
        log.error(red("The response did not contain an access_token."))
        return None
    log.info(green(f"✓ Token obtained ({len(token)} characters, expires in {data.get('expires_in', '?')}s). It is held in memory only."))
    return token


def _build_registration_request(tenant_domain, token, tenant_id, agent_name, source_id,
                                owner_email, owner_name, agent_url):
    """Documented v2 registration request: POST /agent/v2/registry/agents."""
    scheme = "http" if tenant_domain.startswith(("localhost", "127.0.0.1")) else "https"
    url = f"{scheme}://{tenant_domain}/agent/v2/registry/agents"

    headers = {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
        "Accept": "application/json",
        "User-Agent": "ZumaRogueDemoAgent/10.0",
    }
    if tenant_id:
        headers["X-Tenant-Id"] = str(tenant_id)   # documented for tenant-scoped registry calls; omit if not needed

    payload = {
        "name": agent_name,
        "displayName": "Python Rogue Agent Demo",
        "description": "Python Rogue Agent Simulator for Saviynt Enablement.",
        "url": agent_url,
        "environment": "dev",
        "agentType": "autonomous",
        "platform": "python",
        "framework": "custom",
        "version": "10.0.0",
        "criticality": "high",
        "agentMetadata": {
            "sourceId": source_id,
            "execution_runtime": f"python{sys.version_info.major}.{sys.version_info.minor}",
            "script_path": os.path.basename(sys.argv[0]) or "zuma_rogue_agent_v2.py",
        },
        "labels": {"team": "partner-enablement", "data_sensitivity": "internal"},
    }
    if owner_email:   # owners are optional; every email must match an existing tenant user
        payload["owners"] = [{
            "name": owner_name, "email": owner_email, "role": "Technical Owner",
            "rank": 1, "source": "Manual",
        }]
    return url, headers, payload


