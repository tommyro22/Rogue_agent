def send_mcp_request(gateway_url: str, api_key: str, method: str, params: dict) -> dict:
    global _MCP_SESSION_ID

    payload = {
        "jsonrpc": "2.0",
        "id": int(time.time() * 1000) + random.randint(0, 999),
        "method": method,
        "params": params,
    }
    body = json.dumps(payload).encode("utf-8")

    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {api_key}",
        "X-Saviynt-API-Key": api_key,
        "X-Zuma-API-Key": api_key,
        "Zuma-API-Key": api_key,
        "User-Agent": "ZumaRogueDemoAgent/9.0",
    }

    if _MCP_SESSION_ID:
        headers["Mcp-Session-Id"] = _MCP_SESSION_ID
        headers["X-Session-Id"] = _MCP_SESSION_ID

    req = urllib.request.Request(gateway_url, data=body, headers=headers, method="POST")

    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            returned_session = resp.headers.get("Mcp-Session-Id") or resp.headers.get("mcp-session-id")
            if returned_session:
                _MCP_SESSION_ID = returned_session

            raw = resp.read().decode("utf-8")

            # Strip surrounding whitespace — guards against newline-only bodies
            # that are truthy but not parseable JSON.
            response_bytes = raw.strip()
            if not response_bytes:
                return {}

            # The Zuma gateway returns SSE-format events, e.g.:
            #   event: message
            #   data: {"jsonrpc":"2.0", ...}
            # The response may start with "event:" rather than "data:", so check
            # whether ANY line is a data-line rather than just the first.
            lines = response_bytes.splitlines()
            if any(line.startswith("data:") for line in lines):
                data_lines = [
                    line[5:].strip()
                    for line in lines
                    if line.startswith("data:") and line[5:].strip()
                ]
                if data_lines:
                    response_bytes = data_lines[-1]

            try:
                return json.loads(response_bytes)
            except json.JSONDecodeError as exc:
                log.warning(
                    f"Gateway returned non-JSON body (first 200 chars): "
                    f"{response_bytes[:200]!r} — {exc}"
                )
                return {"error": {"code": -32700, "message": f"Non-JSON gateway response: {response_bytes[:200]}"}}
    except urllib.error.HTTPError as e:
        try:
            err_body = e.read().decode("utf-8")
        except Exception:
            err_body = f"HTTP {e.code}: {e.reason}"
        return {"error": {"code": e.code, "message": err_body}}
    except urllib.error.URLError as e:
        return {"error": {"code": 0, "message": str(e.reason)}}


def initialize_gateway_session(gateway_url: str, api_key: str, agent_source_id: str) -> bool:
    log.info("Sending MCP 'initialize' handshake to Access Gateway...")
    params = {
        "protocolVersion": "2024-11-05",
        "capabilities": {},
        "clientInfo": {
            "name": "python-rogue-agent",
            "version": "9.0.0",
            "x-agent-source-id": agent_source_id,
            "cdsBotId": agent_source_id
        }
    }
    resp = send_mcp_request(gateway_url, api_key, "initialize", params)

    if "error" in resp:
        log.error(red(f"MCP Initialization Failed! Gateway message: {resp['error']}"))
        return False

    log.info(green(f"✓ MCP Session Initialized! (Session ID: {_MCP_SESSION_ID or 'Established'})"))
    return True


