RETRYABLE_HTTP = {502, 503, 504, 522, 524}


def send_mcp_request(gateway_url: str, api_key: str, method: str, params: dict, timeout: float = 30) -> dict:
    """POST one JSON-RPC request. Never raises on network trouble; returns {"error": {...}}."""
    global _MCP_SESSION_ID

    payload = {
        "jsonrpc": "2.0",
        "id": int(time.time() * 1000) + random.randint(0, 999),
        "method": method,
        "params": params,
    }
    body = json.dumps(payload).encode("utf-8")

    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {api_key}",
        "X-Saviynt-API-Key": api_key,
        "X-Zuma-API-Key": api_key,
        "Zuma-API-Key": api_key,
        "User-Agent": "ZumaRogueDemoAgent/10.0",
    }

    if _MCP_SESSION_ID:
        headers["Mcp-Session-Id"] = _MCP_SESSION_ID
        headers["X-Session-Id"] = _MCP_SESSION_ID

    req = urllib.request.Request(gateway_url, data=body, headers=headers, method="POST")

    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            returned_session = resp.headers.get("Mcp-Session-Id") or resp.headers.get("mcp-session-id")
            if returned_session:
                _MCP_SESSION_ID = returned_session

            raw = resp.read().decode("utf-8")

            response_bytes = raw.strip()
            if not response_bytes:
                return {}

            # The Zuma gateway returns SSE-format events, e.g.:
            #   event: message
            #   data: {"jsonrpc":"2.0", ...}
            lines = response_bytes.splitlines()
            if any(line.startswith("data:") for line in lines):
                data_lines = [
                    line[5:].strip()
                    for line in lines
                    if line.startswith("data:") and line[5:].strip()
                ]
                if data_lines:
                    response_bytes = data_lines[-1]

            try:
                return json.loads(response_bytes)
            except json.JSONDecodeError as exc:
                log.warning(f"Gateway returned non-JSON body (first 200 chars): {response_bytes[:200]!r} — {exc}")
                return {"error": {"code": -32700, "message": f"Non-JSON gateway response: {response_bytes[:200]}"}}

    except urllib.error.HTTPError as e:
        try:
            err_body = e.read().decode("utf-8")
        except Exception:
            err_body = f"HTTP {e.code}: {e.reason}"
        return {"error": {"code": e.code, "message": err_body}}
    except (TimeoutError, socket.timeout):
        return {"error": {"code": "timeout", "message": f"No response within {timeout:.0f}s", "retryable": True}}
    except urllib.error.URLError as e:
        if isinstance(e.reason, (TimeoutError, socket.timeout)):
            return {"error": {"code": "timeout", "message": f"No response within {timeout:.0f}s", "retryable": True}}
        return {"error": {"code": 0, "message": str(e.reason)}}
    except OSError as e:
        return {"error": {"code": 0, "message": f"Connection problem: {e}"}}


def _retryable(resp: dict) -> bool:
    err = resp.get("error") if isinstance(resp, dict) else None
    if not err:
        return False
    return bool(err.get("retryable")) or err.get("code") in RETRYABLE_HTTP


def call_tool(gateway_url: str, api_key: str, name: str, args: dict, *,
              retries: int = 2, wait: float = None, timeout: float = None) -> dict:
    """tools/call with retry when the back end looks asleep (timeouts / 502-504).

    Note: if a timeout happened AFTER the server acted, a retry repeats the call.
    That is acceptable for dummy servers and simply adds a log line in Zuma.
    """
    wait = RETRY_WAIT if wait is None else wait
    timeout = TOOL_TIMEOUT if timeout is None else timeout
    attempt = 0
    while True:
        res = send_mcp_request(gateway_url, api_key, "tools/call",
                               {"name": name, "arguments": args}, timeout=timeout)
        if not _retryable(res) or attempt >= retries:
            break
        attempt += 1
        log.warning(yellow(
            f"  ⏳ No response — the back end may be asleep (free-tier hosting). "
            f"Retry {attempt}/{retries} in {wait:.0f}s..."))
        time.sleep(wait)

    if _retryable(res):
        res["error"]["message"] = (
            f"The back end did not respond after {retries + 1} attempts. "
            "If the ITSM dummy is on a free tier, open its URL in a browser, wait for it to load, "
            "then try again (the 'Wake up backends' menu option also does this)."
        )
    return res


def initialize_gateway_session(gateway_url: str, api_key: str, agent_source_id: str) -> bool:
    log.info("Sending MCP 'initialize' handshake to Access Gateway...")
    params = {
        "protocolVersion": "2024-11-05",
        "capabilities": {},
        "clientInfo": {
            "name": "python-rogue-agent",
            "version": "10.0.0",
            "x-agent-source-id": agent_source_id,
            "cdsBotId": agent_source_id,
        },
    }
    resp = send_mcp_request(gateway_url, api_key, "initialize", params, timeout=30)

    if "error" in resp:
        log.error(red(f"MCP Initialization Failed! Gateway message: {resp['error']}"))
        if resp["error"].get("code") in (401, 403):
            print(yellow("  Hint: check the gateway URL and the gateway API key (not the registry token).\n"))
        return False

    log.info(green(f"✓ MCP Session Initialized! (Session ID: {_MCP_SESSION_ID or 'Established'})"))
    return True


def load_tool_schemas(gateway_url: str, api_key: str) -> list:
    """Fetch tools/list, cache each tool's input schema. Returns the tool list ([] on failure)."""
    resp = send_mcp_request(gateway_url, api_key, "tools/list", {}, timeout=30)
    if "error" in resp:
        return []
    tools = resp.get("result", {}).get("tools", []) or []
    for t in tools:
        if t.get("name"):
            _TOOL_SCHEMAS[t["name"]] = t.get("inputSchema") or {}
    return tools


