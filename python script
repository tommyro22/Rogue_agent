def step_prompt(phase: str, tool: Tool, arguments: dict) -> bool:
    if not _STEP_MODE:
        return True

    print()
    print(cyan(f"  ┌─ {phase}"))
    print(cyan("  │  Tool:") + f"  {bold(tool.full)}")
    print(cyan("  │  Args:") + f"  {dim(json.dumps(arguments))}")
    print(cyan("  │"))
    print(cyan("  │  ") + yellow("Talking point: ") + TALKING_POINTS.get(tool.short, "Monitored tool call."))
    print(cyan("  │  ") + yellow("With the demo policies, Zuma should log: ") + EXPECTED_TEXT[tool.expected])
    print(cyan("  └─ ") + dim("Enter=fire  s=skip  q=quit  "), end="", flush=True)

    try:
        choice = input().strip().lower()
    except (KeyboardInterrupt, EOFError):
        print()
        sys.exit(0)

    if choice == "q":
        sys.exit(0)
    if choice == "s":
        print(dim("     skipped"))
        return False
    return True


def _result_ok(res: dict) -> bool:
    if not isinstance(res, dict) or "error" in res:
        return False
    return not res.get("result", {}).get("isError", False)


def fire(gateway_url: str, api_key: str, phase: str, short: str, args: dict = None, *, quiet: bool = False):
    """Fire one tool call (scenario use). Returns the response dict, or None if skipped in step mode."""
    tool = BY_SHORT[short]
    arguments = resolve_args(tool, args)

    if not step_prompt(phase, tool, arguments):
        return None

    if not quiet:
        log.info(f"→ {bold(tool.full)}  {dim(json.dumps(arguments))}")

    result = call_tool(gateway_url, api_key, tool.full, arguments)

    if "error" in result:
        log.warning(f"  ← {red('ERROR')}  {result['error']}")
    elif not _result_ok(result):
        log.warning(f"  ← {red('TOOL ERROR')}  {json.dumps(result.get('result', {}))[:300]}")
    elif not quiet:
        log.info(f"  ← {green('OK')}  Response: {dim(json.dumps(result.get('result', {}))[:240])}")
    return result


def run_single_tool(gw_url: str, api_key: str, tool: Tool):
    arguments = resolve_args(tool)

    if not step_prompt("Single tool call", tool, arguments):
        return

    print("\n" + "─" * 62)
    log.info(f"Invoking Tool: {bold(tool.full)}")
    log.info(f"Arguments: {arguments}")

    res = call_tool(gw_url, api_key, tool.full, arguments)

    if "error" in res:
        log.warning(f"  ← {red('ERROR')}  {res['error']}")
    elif not _result_ok(res):
        log.warning(f"  ← {red('TOOL ERROR')}")
    else:
        log.info(f"  ← {green('OK')}")

    print(cyan("\n  Gateway Response:"))
    print("  " + "\n  ".join(json.dumps(res, indent=2).splitlines()))
    print(dim(f"\n  With the demo policies, Zuma Evaluation Logs should show: {EXPECTED_TEXT[tool.expected]}"))
    print("─" * 62 + "\n")


def pause(seconds: float):
