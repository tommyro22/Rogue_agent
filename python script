def option_test_tools(gateway_url: str, api_key: str):
    print("\n" + "=" * 62)
    print(bold(" Connection Test: Fetching Tool Catalog ('tools/list')"))
    print("=" * 62)

    tools = load_tool_schemas(gateway_url, api_key)
    if not tools:
        log.error(red("Tools list failed or returned no tools. Check the gateway URL, key and targets."))
        return False

    log.info(green(f"✓ Success! Gateway exposed {len(tools)} downstream tools."))
    print("\n  Available tools (required parameters in brackets):")
    for t in tools:
        req = (t.get("inputSchema") or {}).get("required") or []
        print(f"   - {t.get('name')}  {dim('[' + ', '.join(req) + ']') if req else ''}")

    exposed = {t.get("name") for t in tools}
    missing = [x.full for x in TOOLS if x.full not in exposed]
    if missing:
        print(yellow(f"\n  Note: {len(missing)} of the 13 expected tool names were not found exactly as the script builds them:"))
        for m in missing:
            print(yellow(f"   - {m}"))
        print(yellow("  If the gateway shows a different prefix, restart with --itsm-prefix / --crm-prefix."))
    print()
    return True


def wake_backends(gateway_url: str, api_key: str):
    """One harmless read per back end, with a long timeout, to wake free-tier hosting."""
    print("\n" + "=" * 62)
    print(bold(" Waking up back ends (free-tier hosting can take 30-60s)"))
    print("=" * 62)
    print(dim("  This makes two harmless read calls, so you will see two entries in the Zuma logs.\n"))

    all_ok = True
    for tool in (BY_SHORT["get_ticket_status"], BY_SHORT["list_customers"]):
        label = "ITSM" if tool.system == "ITSM" else "CRM "
        start = time.time()
        log.info(f"  {label}  calling {tool.short} ...")
        res = call_tool(gateway_url, api_key, tool.full, resolve_args(tool),
                        retries=3, wait=10, timeout=90)
        took = time.time() - start
        if _result_ok(res):
            log.info(f"  {label}  {green('awake')}  ({took:.0f}s)")
        else:
            all_ok = False
            log.warning(f"  {label}  {red('not responding')}  ({took:.0f}s)  {res.get('error', '')}")
    print()
    if all_ok:
        print(green("  ✓ Both back ends are responding.\n"))
    else:
        print(yellow("  One or more back ends did not respond. Open their URLs in a browser, wait, and run this again.\n"))
    return all_ok


