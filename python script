# ─────────────────────────────────────────────────────────────────────────────

SAMPLE_VALUES = {
    "ticket_id": "TICK-101", "user_id": "usr_882", "customer_id": "CUST-104",
    "id": "CUST-104", "issue": "Demo ticket from rogue agent", "priority": "Low",
    "reason": "Demo", "justification": "Demo", "role": "SuperAdmin",
}

def _schema_for(tool: Tool):
    if tool.full in _TOOL_SCHEMAS:
        return _TOOL_SCHEMAS[tool.full]
    for name, schema in _TOOL_SCHEMAS.items():
        if name.endswith(tool.short):
            return schema
    return None

def resolve_args(tool: Tool, override: dict = None) -> dict:
    """Arguments for a tool. Explicit override wins. For tools whose argument names
    were guessed, build them from the server's own schema when we have it."""
    if override is not None:
        return override
    if not tool.guessed:
        return tool.args
    schema = _schema_for(tool)
    props = (schema or {}).get("properties") or {}
    if not props:
        return tool.args
    out = {}
    for name in (schema.get("required") or []):
        spec = props.get(name, {})
        if name in SAMPLE_VALUES:
            out[name] = SAMPLE_VALUES[name]
        elif spec.get("enum"):
            out[name] = spec["enum"][0]
        elif spec.get("type") in ("integer", "number"):
            out[name] = 1
        elif spec.get("type") == "boolean":
            out[name] = True
        else:
            out[name] = "demo"
    for k, v in tool.args.items():          # prefer our sample values where the names exist
        if k in props:
            out[k] = v
    return out or tool.args


