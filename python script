def step_prompt(phase: str, tool_name: str, arguments: dict) -> bool:
    if not _STEP_MODE:
        return True

    print()
    print(cyan(f"  ┌─ {phase}"))
    print(cyan("  │  Tool:") + f"  {bold(tool_name)}")
    print(cyan("  │  Args:") + f"  {dim(json.dumps(arguments))}")
    print(cyan("  │"))
    print(cyan("  │  ") + yellow("Talking point: ") + TALKING_POINTS.get(tool_name, "Monitored tool call."))
    print(cyan("  └─ ") + dim("Enter=fire  s=skip  q=quit  "), end="", flush=True)

    try:
        choice = input().strip().lower()
    except (KeyboardInterrupt, EOFError):
        sys.exit(0)

    if choice == "q":
        sys.exit(0)
    if choice == "s":
        print(dim("     skipped"))
        return False
    return True

def fire(gateway_url: str, api_key: str, phase: str, tool_name: str, arguments: dict, *, quiet: bool = False) -> dict:
    if not step_prompt(phase, tool_name, arguments):
        return {}

    if not quiet:
        log.info(f"→ {bold(tool_name)}  {dim(json.dumps(arguments))}")

    result = send_mcp_request(gateway_url, api_key, "tools/call", {"name": tool_name, "arguments": arguments})

    if "error" in result:
        log.warning(f"  ← {red('ERROR')}  {result['error']}")
    else:
        if not quiet:
            inner_result = result.get('result', {})
            log.info(f"  ← {green('OK')}  Response: {dim(json.dumps(inner_result))}")
    return result

def run_single_tool(gw_url: str, api_key: str, tool_name: str, args: dict):
    print("\n" + "─"*62)
    log.info(f"Invoking Tool: {bold(tool_name)}")
    log.info(f"Arguments: {args}")

    res = send_mcp_request(gw_url, api_key, "tools/call", {"name": tool_name, "arguments": args})

    if "error" in res:
        log.warning(f"  ← {red('ERROR')}  {res['error']}")
    else:
        log.info(f"  ← {green('OK')}")

    print(cyan("\n  Gateway Response:"))
    print("  " + "\n  ".join(json.dumps(res, indent=2).splitlines()))
    print("─"*62 + "\n")

def pause(seconds: float):
    if not _STEP_MODE:
        time.sleep(seconds)

def _header(title: str, subtitle: str, capability: str):
    print(f"\n  {bold(title)}\n  {dim(subtitle)}\n  Capability: {cyan(capability)}\n  " + "─"*62)

def _footer(msg: str):
    print(f"\n  {green('✓')}  {msg}\n  {dim(f'Session ID: {_MCP_SESSION_ID}')}\n")


def option_test_tools(gateway_url: str, api_key: str):
    print("\n" + "="*62)
    print(bold(" Connection Test: Fetching Tool Catalog ('tools/list')"))
    print("="*62)
    
    tools_resp = send_mcp_request(gateway_url, api_key, "tools/list", {})
    if "error" in tools_resp:
        log.error(red(f"Tools list failed: {tools_resp['error']}"))
        return False

    tools = tools_resp.get("result", {}).get("tools", [])
    log.info(green(f"✓ Success! Gateway exposed {len(tools)} downstream tools."))
    if tools:
        print("\n  Available tools:")
        for t in tools:
            print(f"   - {t.get('name')}")
    print()
    return True

def scenario_volumetric(gw_url: str, api_key: str, call_count: int = 30, interval: float = 0.5):
    _header("Scenario 1 — Volumetric Anomaly", f"{call_count} calls, {interval}s interval", "Volumetric")
    start = time.time()
    for i in range(1, call_count + 1):
        fire(gw_url, api_key, f"Call {i}/{call_count}", f"{ITSM_PREFIX}get_ticket_status", {"ticket_id": random.choice(TICKET_IDS)}, quiet=(i > 1 and not _STEP_MODE))
        if i == 1 and not _STEP_MODE: log.info(dim(f"  ({call_count - 1} more calls executing...)"))
        pause(interval)
    _footer(f"Volumetric completed in {time.time()-start:.1f}s")

def scenario_drift(gw_url: str, api_key: str):
    _header("Scenario 2 — Behaviour Drift", "ITSM-baseline agent pivoting into CRM", "Drift")
    fire(gw_url, api_key, "Baseline", f"{ITSM_PREFIX}get_ticket_status", {"ticket_id": "TICK-101"})
    pause(1.0)
    fire(gw_url, api_key, "Pivot start", f"{CRM_PREFIX}list_customers", {})
    pause(1.0)
    fire(gw_url, api_key, "Enumeration", f"{CRM_PREFIX}get_customer_by_id", {"id": "CUST-104"})
    pause(1.0)
    fire(gw_url, api_key, "Malicious Act", f"{CRM_PREFIX}update_credit_limit", {"id": "CUST-104", "newLimit": 999999, "reason": "VIP Override"})
    pause(1.0)
    fire(gw_url, api_key, "Exfiltration", f"{CRM_PREFIX}export_customer_data", {})
    _footer("Drift scenario executed.")

def scenario_iara(gw_url: str, api_key: str):
    _header("Scenario 3 — IARA Intent Pattern", "Recon → Scope → Privilege Escalation", "IARA")
    for user in USER_IDS:
        fire(gw_url, api_key, "Recon", f"{ITSM_PREFIX}check_user_permissions", {"user_id": user})
        pause(1.0)
    fire(gw_url, api_key, "Scope", f"{ITSM_PREFIX}search_tickets_by_customer", {"customer_id": "CUST-104"})
    pause(1.0)
    fire(gw_url, api_key, "Escalate", f"{ITSM_PREFIX}escalate_ticket_priority", {"ticket_id": "TICK-101", "new_priority": "Critical", "justification": "Emergency Access"})
    pause(1.0)
    fire(gw_url, api_key, "Payload 1", f"{ITSM_PREFIX}grant_admin_privilege", {"user_id": "usr_882", "role": "SuperAdmin"})
    pause(1.0)
    fire(gw_url, api_key, "Payload 2", f"{ITSM_PREFIX}purge_audit_logs", {"retention_days": 0})
    _footer("IARA sequence executed.")


