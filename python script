def _build_menu():
    """Returns (ordered list of (number, label, action), rendered lines)."""
    items = []   # (kind, text, payload)
    n = 1
    def add(label, action):
        nonlocal n
        items.append(("opt", n, label, action)); n += 1
    def sec(text):
        items.append(("sec", text))

    add("Test Connection & List All Tools", "test")
    add("Wake up backends (free-tier cold start)", "wake")
    for system, title in (("ITSM", f"ITSM tools ({ITSM_PREFIX.rstrip('_')})"), ("CRM", f"CRM tools ({CRM_PREFIX.rstrip('_')})")):
        sec(title)
        for t in [x for x in TOOLS if x.system == system]:
            add(t.short, ("tool", t))
    sec("Policy demo")
    add("Run Policy Demo: all 13 tools, grouped by expected outcome", "policy")
    sec("Go Rogue: Automated Scenarios")
    add("Run Scenario 1: Volumetric Anomaly", "s1")
    add("Run Scenario 2: Behavior Drift", "s2")
    add("Run Scenario 3: IARA Intent Pattern", "s3")
    add("Run ALL Scenarios", "all")
    add("Exit to Main Menu", "exit")
    return items

def run_tool_invocation_mode():
    print("\n" + "=" * 62)
    print(bold(" TOOL INVOCATION MODE — Runtime Gateway Setup"))
    print("=" * 62)

    gw_def = os.environ.get("ZUMA_GATEWAY_URL", "https://identity-beta-gateway-dataplane.saviyntcloud.com/mcp/YOUR_GATEWAY_ID")
    gateway_url = input(f" Enter Gateway URL [{gw_def}]: ").strip() or gw_def

    key_def = os.environ.get("ZUMA_GATEWAY_API_KEY", "")
    if key_def:
        api_key = getpass.getpass(" Enter Gateway API Key [hidden, press Enter for env default]: ").strip() or key_def
    else:
        api_key = getpass.getpass(" Enter Gateway API Key [hidden]: ").strip()

    source_def = (f"agent-registry:{_REGISTERED_AGENT_ID}" if _REGISTERED_AGENT_ID else os.environ.get("ZUMA_AGENT_SOURCE_ID", "python-script-001"))
    agent_source_id = input(f" Enter Agent Source ID for the MCP handshake [{source_def}]: ").strip() or source_def

    if not api_key or "YOUR_GATEWAY_ID" in gateway_url:
        print(red("\n Error: Valid Gateway URL and Gateway API Key are required.\n"))
        return

    if not initialize_gateway_session(gateway_url, api_key, agent_source_id):
        return

    # Cache tool schemas quietly so guessed arguments can be built from them
    load_tool_schemas(gateway_url, api_key)

    menu = _build_menu()
    last = max(i[1] for i in menu if i[0] == "opt")
    actions = {i[1]: i[3] for i in menu if i[0] == "opt"}

    while True:
        print("\n" + "─" * 62)
        print(bold(" TOOL INVOCATION MENU — Select Action"))
        print("─" * 62)
        for item in menu:
            if item[0] == "sec":
                print(dim(f"  --- {item[1]} ---"))
            else:
                _, num, label, action = item
                if isinstance(action, tuple):
                    t = action[1]
                    tag = TIER_COLOUR[t.tier](f"[{t.tier}]")
                    print(f" {num:>2}) {t.short:<28} {tag}")
                else:
                    print(f" {num:>2}) {label}")
        print("─" * 62)

        choice = input(f" Select option [1-{last}]: ").strip()
        if not choice.isdigit() or int(choice) not in actions:
            print(red(f" Invalid choice. Select 1-{last}."))
            continue

        action = actions[int(choice)]
        try:
            if action == "test":
                option_test_tools(gateway_url, api_key)
            elif action == "wake":
                wake_backends(gateway_url, api_key)
            elif action == "policy":
                scenario_policy_demo(gateway_url, api_key)
            elif action == "s1":
                scenario_volumetric(gateway_url, api_key)
            elif action == "s2":
                scenario_drift(gateway_url, api_key)
            elif action == "s3":
                scenario_iara(gateway_url, api_key)
            elif action == "all":
                if option_test_tools(gateway_url, api_key):
                    scenario_volumetric(gateway_url, api_key)
                    scenario_drift(gateway_url, api_key)
                    scenario_iara(gateway_url, api_key)
            elif action == "exit":
                break
            elif isinstance(action, tuple):
                run_single_tool(gateway_url, api_key, action[1])
        except KeyboardInterrupt:
            print(yellow("\n  Interrupted. Back to the menu.\n"))


